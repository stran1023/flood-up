rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{filename} {
      // Anyone (including unauthenticated) can read report photos for map display
      allow read: if true;
      // Only authenticated users can upload; max 10 MB per file
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
